# Copy to .env for local development. The values below are throwaway defaults for the local
# database container; production values are set in the deployment platform, never in a file.

# --- Local Postgres container (infra/docker-compose.dev.yml)
POSTGRES_PORT=5433
POSTGRES_PASSWORD=local-superuser
MIGRATOR_DB_PASSWORD=local-migrator
APP_DB_PASSWORD=local-app

# --- Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=local-development-only
# The api and every test connect as app, the role that row-level security applies to.
DATABASE_URL=postgres://app:local-app@127.0.0.1:5433/jobseeker
# Used only to run migrations and to create the test database.
MIGRATOR_DATABASE_URL=postgres://migrator:local-migrator@127.0.0.1:5433/jobseeker
